# Copy to .env on the server and fill in. Never commit the filled-in file.

# The domain the bridge answers on. Its DNS must already point at this server.
# Example: ai-bridge.yourdomain.com
BRIDGE_DOMAIN=

# The password the dashboard uses to talk to the bridge. Generate a fresh one:
#   openssl rand -base64 48
# The same value goes into Vercel as BRIDGE_TOKEN.
BRIDGE_TOKEN=

# Which backend answers when a request does not name one. "codex" is ChatGPT.
DEFAULT_BACKEND=codex

# How long a single answer may take before it is given up on, in milliseconds.
TURN_TIMEOUT_MS=300000

# Only needed if you configure OmniRoute to require a key of its own.
OMNIROUTE_API_KEY=

# Copy to .env and fill in. Never commit .env.

# From `claude setup-token` on a machine where you are logged into Claude Code.
# Authorises your whole Claude account — treat it like a password.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-...

# Generate with: openssl rand -hex 32
# The SAME value must be set as SANDBOX_SHARED_SECRET in Vercel.
SANDBOX_SHARED_SECRET=

# Optional
PORT=8787
CLAUDE_TIMEOUT_MS=120000
